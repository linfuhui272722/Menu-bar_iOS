#!/bin/sh
# MacBar postinst — self-healing, never-fail, find-based relocation.
#
# Root cause of "files not in /var/jb/usr/lib/TweakInject": on this Sileo/dpkg
# rootless setup, dpkg unpacks with an instdir equal to the jailbreak root
# (the real path behind /var/jb) instead of "/". Because the deb already
# carries the /var/jb prefix, files land at <jbroot>/var/jb/... which resolves
# to /var/jb/var/jb/... (nested). dpkg -L reports the LOGICAL path
# (/var/jb/usr/lib/TweakInject/MacBar.dylib) but the file is NOT there, so a
# naive `[ -f "$(dpkg -L ...)" ]` check fails and the self-heal copy never
# runs. Fix: use `find` to locate the file's REAL on-disk path (nested or
# not), then force-copy into the canonical location.
LOG=${MB_LOG:-/var/jb/var/mobile/MacBar_install.log}
REALDIR=${MB_REALDIR:-/var/jb/usr/lib/TweakInject}
MSDIR=${MB_MSDIR:-/var/jb/Library/MobileSubstrate/DynamicLibraries}
PKG=${MB_PKG:-com.linfunui.macbar}

mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

JBROOT=$(readlink /var/jb 2>/dev/null || echo "/var/jb")
{
  echo "==== postinst $(date) ===="
  echo "argv: $0 $*"
  echo "DPKG_ROOT=${DPKG_ROOT:-}"
  echo "/var/jb -> ${JBROOT}"
  echo "dpkg admindir: $(ls -d /var/jb/Library/dpkg 2>/dev/null)"
  echo "--- dpkg -L $PKG ---"
  dpkg -L "$PKG" 2>&1
} > "$LOG" 2>&1

# Search the whole jailbreak root for the real on-disk location of each
# artifact. This finds files even when they were unpacked into a nested
# <jbroot>/var/jb/... path.
find_real() {
  # $1 = basename, $2 = -f (file) or -d (dir)
  find "${JBROOT}" -name "$1" $2 2>/dev/null | head -n1
}

DYLIB_REAL=$(find_real MacBar.dylib -type f)
PLIST_REAL=$(find_real MacBar.plist -type f)
BUNDLE_REAL=$(find_real MacBar.bundle -type d)

{
  echo "dylib_real=${DYLIB_REAL:-NOTFOUND}"
  echo "plist_real=${PLIST_REAL:-NOTFOUND}"
  echo "bundle_real=${BUNDLE_REAL:-NOTFOUND}"
} >> "$LOG" 2>&1

mkdir -p "$REALDIR" 2>/dev/null || true

# Force each artifact into the canonical TweakInject path.
if [ -n "$DYLIB_REAL" ] && [ -f "$DYLIB_REAL" ]; then
  cp -f "$DYLIB_REAL" "$REALDIR/MacBar.dylib" 2>>"$LOG" || true
  chmod 0755 "$REALDIR/MacBar.dylib" 2>/dev/null || true
  echo "placed dylib (from $DYLIB_REAL)" >>"$LOG" 2>&1
else
  echo "WARNING: MacBar.dylib not found anywhere under $JBROOT" >> "$LOG" 2>&1
fi

if [ -n "$PLIST_REAL" ] && [ -f "$PLIST_REAL" ]; then
  cp -f "$PLIST_REAL" "$REALDIR/MacBar.plist" 2>>"$LOG" || true
  echo "placed plist (from $PLIST_REAL)" >>"$LOG" 2>&1
else
  echo "WARNING: MacBar.plist not found anywhere under $JBROOT" >> "$LOG" 2>&1
fi

if [ -n "$BUNDLE_REAL" ] && [ -d "$BUNDLE_REAL" ]; then
  rm -rf "$REALDIR/MacBar.bundle" 2>>"$LOG" || true
  cp -Rf "$BUNDLE_REAL" "$REALDIR/MacBar.bundle" 2>>"$LOG" || true
  echo "placed bundle (from $BUNDLE_REAL)" >>"$LOG" 2>&1
else
  echo "WARNING: MacBar.bundle not found anywhere under $JBROOT" >> "$LOG" 2>&1
fi

# Classic MobileSubstrate path compat symlinks.
if [ -d "$MSDIR" ]; then
  for f in MacBar.dylib MacBar.plist MacBar.bundle; do
    [ -e "$MSDIR/$f" ] && [ ! -L "$MSDIR/$f" ] && { rm -rf "$MSDIR/$f" 2>/dev/null || true; }
  done
  if [ -e "$REALDIR/MacBar.dylib" ]; then
    ln -sf "$REALDIR/MacBar.dylib" "$MSDIR/MacBar.dylib" 2>/dev/null || true
    ln -sf "$REALDIR/MacBar.plist" "$MSDIR/MacBar.plist" 2>/dev/null || true
    ln -sfn "$REALDIR/MacBar.bundle" "$MSDIR/MacBar.bundle" 2>/dev/null || true
  fi
fi

rm -f /var/jb/var/mobile/MacBar.log 2>/dev/null || true

# Final snapshot.
{
  echo "--- post-postinst snapshot of $REALDIR ---"
  ls -l "$REALDIR" 2>&1
  echo "dylib exists: $([ -f "$REALDIR/MacBar.dylib" ] && echo YES || echo NO)"
  echo "plist exists: $([ -f "$REALDIR/MacBar.plist" ] && echo YES || echo NO)"
  echo "bundle exists: $([ -d "$REALDIR/MacBar.bundle" ] && echo YES || echo NO)"
  echo "==== postinst done, exiting 0 ===="
} >> "$LOG" 2>&1

exit 0
