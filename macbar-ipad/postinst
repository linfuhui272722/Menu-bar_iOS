#!/bin/sh
# MacBar postinst — self-healing + never-fail.
#
# Observed on device: dpkg unpacks the files into /var/jb/usr/lib/TweakInject/
# correctly (the install log proves it), but by the time the user checks,
# the files are gone. The most likely cause is Sileo rolling back the whole
# install when postinst does not exit 0 cleanly (a failed/half-aborted
# postinst makes Sileo undo the unpack). So this script is deliberately
# defensive: no `set -e`/`set -u`, every destructive/external call guarded,
# and it always exits 0. It also writes a final snapshot so we can tell
# whether the files survived postinst itself.
LOG=${MB_LOG:-/var/jb/var/mobile/MacBar_install.log}
REALDIR=${MB_REALDIR:-/var/jb/usr/lib/TweakInject}
MSDIR=${MB_MSDIR:-/var/jb/Library/MobileSubstrate/DynamicLibraries}
PKG=${MB_PKG:-com.linfunui.macbar}

mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

{
  echo "==== postinst $(date) ===="
  echo "argv: $0 $*"
  echo "DPKG_ROOT=${DPKG_ROOT:-}"
  echo "/var/jb -> $(readlink /var/jb 2>/dev/null || echo 'not a symlink')"
  echo "--- dpkg -L $PKG ---"
  dpkg -L "$PKG" 2>&1
} > "$LOG" 2>&1

# Locate where dpkg actually placed each artifact (handles nested instdir).
DYLIB_SRC=$(dpkg -L "$PKG" 2>/dev/null | grep -E '/MacBar\.dylib$' | head -n1 || true)
PLIST_SRC=$(dpkg -L "$PKG" 2>/dev/null | grep -E '/MacBar\.plist$' | head -n1 || true)
BUNDLE_SRC=$(dpkg -L "$PKG" 2>/dev/null | grep -E '/MacBar\.bundle$' | head -n1 || true)

{
  echo "dylib_src=${DYLIB_SRC:-}"
  echo "plist_src=${PLIST_SRC:-}"
  echo "bundle_src=${BUNDLE_SRC:-}"
} >> "$LOG" 2>&1

mkdir -p "$REALDIR" 2>/dev/null || true

# Relocate dylib.
if [ -n "$DYLIB_SRC" ] && [ -f "$DYLIB_SRC" ]; then
  [ "$DYLIB_SRC" != "$REALDIR/MacBar.dylib" ] && { cp -f "$DYLIB_SRC" "$REALDIR/MacBar.dylib" 2>>"$LOG" || true; echo "relocated dylib" >>"$LOG" 2>&1; }
else
  echo "WARNING: MacBar.dylib not in dpkg -L" >> "$LOG" 2>&1
fi

# Relocate plist.
if [ -n "$PLIST_SRC" ] && [ -f "$PLIST_SRC" ]; then
  [ "$PLIST_SRC" != "$REALDIR/MacBar.plist" ] && { cp -f "$PLIST_SRC" "$REALDIR/MacBar.plist" 2>>"$LOG" || true; echo "relocated plist" >>"$LOG" 2>&1; }
else
  echo "WARNING: MacBar.plist not in dpkg -L" >> "$LOG" 2>&1
fi

# Relocate bundle.
if [ -n "$BUNDLE_SRC" ] && [ -d "$BUNDLE_SRC" ]; then
  if [ "$BUNDLE_SRC" != "$REALDIR/MacBar.bundle" ]; then
    rm -rf "$REALDIR/MacBar.bundle" 2>>"$LOG" || true
    cp -Rf "$BUNDLE_SRC" "$REALDIR/MacBar.bundle" 2>>"$LOG" || true
    echo "relocated bundle" >>"$LOG" 2>&1
  fi
else
  echo "WARNING: MacBar.bundle not in dpkg -L" >> "$LOG" 2>&1
fi

# Classic MobileSubstrate path compat symlinks.
if [ -d "$MSDIR" ]; then
  for f in MacBar.dylib MacBar.plist MacBar.bundle; do
    [ -e "$MSDIR/$f" ] && [ ! -L "$MSDIR/$f" ] && { rm -rf "$MSDIR/$f" 2>/dev/null || true; }
  done
  if [ -e "$REALDIR/MacBar.dylib" ]; then
    ln -sf "$REALDIR/MacBar.dylib" "$MSDIR/MacBar.dylib" 2>/dev/null || true
    ln -sf "$REALDIR/MacBar.plist" "$MSDIR/MacBar.plist" 2>/dev/null || true
    ln -sfn "$REALDIR/MacBar.bundle" "$MSDIR/MacBar.bundle" 2>/dev/null || true
  fi
fi

rm -f /var/jb/var/mobile/MacBar.log 2>/dev/null || true

# Final snapshot: do the files survive postinst itself?
{
  echo "--- post-postinst snapshot of $REALDIR ---"
  ls -l "$REALDIR" 2>&1
  echo "dylib exists: $([ -f "$REALDIR/MacBar.dylib" ] && echo YES || echo NO)"
  echo "plist exists: $([ -f "$REALDIR/MacBar.plist" ] && echo YES || echo NO)"
  echo "bundle exists: $([ -d "$REALDIR/MacBar.bundle" ] && echo YES || echo NO)"
  echo "==== postinst done, exiting 0 ===="
} >> "$LOG" 2>&1

exit 0
